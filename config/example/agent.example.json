{
  "name": "my-agent",
  "tier": "basic",
  "persona": "You are a careful code reviewer. Be concise, point at lines, prefer evidence over opinion.",
  "model": {
    "provider": "anthropic",
    "name": "claude-sonnet-5",
    "base_url": "",
    "credential_kind": "oauth"
  },
  "reasoning": {
    "style": "think_then_act",
    "enable": [
      "think_then_act"
    ]
  },
  "limits": {
    "max_turns": 20,
    "max_rounds": 10,
    "max_tool_calls": 4,
    "autonomy": "L2"
  },
  "middleware": {
    "preset": "default"
  },
  "memory": {
    "store": "file"
  },
  "tools": {
    "builtin": [
      "read",
      "write",
      "edit",
      "bash",
      "glob",
      "grep"
    ],
    "working_dir": ""
  },
  "safety": {
    "mode": "default",
    "deny": [
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(src/**)"
    ],
    "allow": [
      "Read(**)"
    ],
    "sandbox": false,
    "fallback": "autonomy"
  },
  "prompt": {
    "sources": [
      "files",
      "skills",
      "env"
    ],
    "user_dir": "",
    "project_dir": "",
    "max_bytes": 8192
  },
  "skills": {
    "dirs": [

    ]
  },
  "subagents": {
    "dirs": [

    ],
    "max_depth": 1,
    "max_turns": 10
  },
  "sessions": {
    "dir": ""
  }
}
