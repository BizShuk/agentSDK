go 1.26.0

// Two sample categories, and the directory prefix says which is which:
//
//	demo-*   one SDK component wired by hand, no agent framework
//	*-agent  a complete agent (all but logdoctor-agent go through agent/)
use (
	.
	./sample/code-agent
	./sample/demo-memory
	./sample/demo-middleware
	./sample/demo-strategy
	./sample/file-agent
	./sample/greet-agent
	./sample/log-agent-v2
	./sample/logdoctor-agent
	./sample/skeleton-agent
)
